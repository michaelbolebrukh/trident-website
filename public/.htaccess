# Trident Modular — static site served from Hostinger (LiteSpeed).

# ─── Security headers ───
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ─── Compression ───
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─── Caching ───
# Astro fingerprints everything in /_astro/, so those are safe to cache forever.
# HTML must stay uncached or visitors keep seeing the previous deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ─── Clean URLs ───
# Astro builds directory-style routes (/contact/index.html), so map
# /contact and /contact/ to the same file and keep one canonical form.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Add the trailing slash for extensionless paths that exist as directories.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>



# ─── Migration redirects (301) ───
# Generated by scripts/build-redirects.py from the WordPress export.
# A permanent redirect passes ranking signals to the new URL; without these
# every indexed page would 404 at cutover.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # All 23 models keep their /houses/<slug>/ URL, so no
  # rule is needed for them. /catalogue/ was used while the site was in
  # development and is folded back in here.
  RewriteRule ^catalogue/([^/]+)/?$ /houses/$1/ [R=301,L]
  RewriteRule ^catalogue/?$ /houses-type/ [R=301,L]
  RewriteRule ^about/?$ /about_us/ [R=301,L]
  RewriteRule ^contact/?$ /contact-us/ [R=301,L]
  RewriteRule ^bespoke/?$ /customise-your-build/ [R=301,L]

  # 24 blog posts lost their placeholder category segment.
  RewriteRule ^blog/uncategorized-en_gb/(.+)$ /blog/$1 [R=301,L]

  # Pages that moved or were folded into another page.
  RewriteRule ^category/?$ /blog/ [R=301,L]
  RewriteRule ^commercial/?$ /customise-your-build/#support [R=301,L]
  RewriteRule ^eco-modular-homes/?$ /customise-your-build/#sustainable [R=301,L]
  RewriteRule ^example-product-page/?$ /houses-type/ [R=301,L]
  RewriteRule ^gotovi-proyekty-karkasnyh-budynkiv/?$ /gallery/ [R=301,L]
  RewriteRule ^gotovi-proyekty-modulnyh-budynkiv/?$ /gallery/ [R=301,L]
  RewriteRule ^installation/garden-office-with-electrics/?$ /houses/garden-studio/ [R=301,L]
  RewriteRule ^installation/our-solution/?$ /installation/ [R=301,L]
  RewriteRule ^installation/permissions-for-modular-building/?$ /faq/ [R=301,L]
  RewriteRule ^london/?$ /houses-type/ [R=301,L]
  RewriteRule ^modular-building-company-uk/?$ /about_us/ [R=301,L]
  RewriteRule ^modular-home-cost-uk/?$ /houses-type/ [R=301,L]
  RewriteRule ^proyektuvannya/?$ /customise-your-build/ [R=301,L]
  RewriteRule ^self-build-modular-homes/?$ /houses-type/ [R=301,L]
  RewriteRule ^tag/?$ /blog/ [R=301,L]
  RewriteRule ^vyrobnycztvo/?$ /technology/ [R=301,L]

  # 10 case studies are not carried over individually;
  # the gallery replaces them.
  RewriteRule ^case-study/(.*)$ /gallery/ [R=301,L]
</IfModule>
# Astro emits the 404 as /404.html, not a directory-style route.
ErrorDocument 404 /404.html
