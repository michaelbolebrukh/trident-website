---
/**
 * Shell for the legal pages.
 *
 * They are one narrow column of prose with numbered sections, so the header
 * sits on the same column as the text rather than out at the page margin.
 */
import BaseLayout from './BaseLayout.astro'

interface Props {
  title: string
  metaTitle: string
  description: string
  /** Shown under the heading, e.g. "Last updated: 9 June 2026". */
  updated?: string
}

const { title, metaTitle, description, updated } = Astro.props
---

<BaseLayout title={metaTitle} description={description}>
  <div class="bg-white">
    <div class="bg-light border-b border-border py-12">
      <div class="max-w-3xl mx-auto px-6 lg:px-8">
        <p class="text-xs font-semibold font-display uppercase tracking-[0.2em] text-gold mb-3">
          Legal
        </p>
        <h1 class="font-display font-bold text-navy text-4xl lg:text-5xl">{title}</h1>
        {updated && <p class="text-muted text-sm mt-4">{updated}</p>}
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-6 lg:px-8 py-14 legal-body">
      <slot />
    </div>
  </div>
</BaseLayout>

<style is:global>
  .legal-body {
    color: var(--color-body);
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .legal-body > * + * {
    margin-top: 1.15rem;
  }
  .legal-body h2 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-navy);
    font-size: 1.5rem;
    line-height: 1.3;
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }
  /* The first section follows the page header, which already divides it. */
  .legal-body h2:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .legal-body h3 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-navy);
    font-size: 1.15rem;
    line-height: 1.35;
    margin-top: 2rem;
  }
  .legal-body a {
    color: var(--color-navy);
    text-decoration: underline;
    text-underline-offset: 2px;
    /* Long URLs and addresses must not push the column wider on a phone. */
    overflow-wrap: anywhere;
  }
  .legal-body a:hover {
    color: var(--color-gold);
  }
  .legal-body ul {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .legal-body ol {
    list-style: decimal;
    padding-left: 1.5rem;
  }
  .legal-body li + li {
    margin-top: 0.35rem;
  }
  .legal-body strong {
    color: var(--color-navy);
    font-weight: 600;
  }
</style>
