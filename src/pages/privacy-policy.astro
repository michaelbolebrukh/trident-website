---
import { seoFor } from '../data/seo'
import BaseLayout from '../layouts/BaseLayout.astro'
import { Content } from '../data/privacy-policy.md'

/*
 * The policy is held as Markdown rather than carried over from the WordPress
 * export. Trident supplied this text as the authoritative version — it adds
 * the company number, registered office and ICO details the exported copy did
 * not have — and Markdown keeps it something they can edit without touching
 * markup.
 */

const meta = seoFor(
  '/privacy-policy/',
  'Privacy Policy',
  'How Trident Modular Housing Ltd collects, uses and protects your personal data, the lawful bases we rely on, and your rights under UK data protection law.',
)
---

<BaseLayout title={meta.title} description={meta.description}>
  <div class="bg-white">
    {/* Header sits on the same column as the prose. A legal page is one
        narrow measure of text, so a title out at the page margin reads as
        belonging to something else. */}
    <div class="bg-light border-b border-border py-12">
      <div class="max-w-3xl mx-auto px-6 lg:px-8">
        <p class="text-xs font-semibold font-display uppercase tracking-[0.2em] text-gold mb-3">
          Legal
        </p>
        <h1 class="font-display font-bold text-navy text-4xl lg:text-5xl">Privacy Policy</h1>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-6 lg:px-8 py-14 legal-body">
      <Content />
    </div>
  </div>
</BaseLayout>

<style is:global>
  .legal-body {
    color: var(--color-body);
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .legal-body > * + * {
    margin-top: 1.15rem;
  }
  .legal-body h2 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-navy);
    font-size: 1.5rem;
    line-height: 1.3;
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }
  /* The first section follows the page header, which already divides it. */
  .legal-body h2:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .legal-body h3 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-navy);
    font-size: 1.15rem;
    line-height: 1.35;
    margin-top: 2rem;
  }
  .legal-body a {
    color: var(--color-navy);
    text-decoration: underline;
    text-underline-offset: 2px;
    /* Long URLs and addresses must not push the column wider on a phone. */
    overflow-wrap: anywhere;
  }
  .legal-body a:hover {
    color: var(--color-gold);
  }
  .legal-body ul {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .legal-body li + li {
    margin-top: 0.35rem;
  }
  .legal-body strong {
    color: var(--color-navy);
    font-weight: 600;
  }
</style>
