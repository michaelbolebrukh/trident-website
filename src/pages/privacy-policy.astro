---
import { seoFor } from '../data/seo'
import LegalPage from '../layouts/LegalPage.astro'
import { Content } from '../data/privacy-policy.md'

/*
 * Trident supplied this text as the authoritative version — it carries the
 * company number, registered office and ICO details the WordPress export did
 * not have. Held as Markdown so it stays editable without touching markup,
 * and so re-running the page importer cannot clobber it.
 */

const meta = seoFor(
  '/privacy-policy/',
  'Privacy Policy',
  'How Trident Modular Housing Ltd collects, uses and protects your personal data, the lawful bases we rely on, and your rights under UK data protection law.',
)
---

<LegalPage
  title="Privacy Policy"
  metaTitle={meta.title}
  description={meta.description}
  updated="Last updated: 9 June 2026"
>
  <Content />
</LegalPage>
