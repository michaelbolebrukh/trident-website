---
import { postImage } from '../../lib/post-image'
import { seoFor } from '../../data/seo'
import BaseLayout from '../../layouts/BaseLayout.astro'
import posts from '../../data/posts.json'
import { routes } from '../../lib/routes'

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }))
}

const { post } = Astro.props

const published = new Date(post.date)
const formatted = published.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
const readMinutes = Math.max(1, Math.round(post.words / 200))

// Where this post sits in the run, so we can offer the next one to read.
const index = posts.findIndex((p) => p.slug === post.slug)
const more = posts.filter((_, i) => i !== index).slice(0, 3)

// Shown only when we hold the file locally; see src/lib/post-image.ts.
const heroImage = postImage(post.image)

// Article schema. Google uses it for the byline and date in results.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  datePublished: post.date,
  dateModified: post.date,
  description: post.seoDescription || post.excerpt,
  image: heroImage,
  author: { '@type': 'Organization', name: 'Trident Modular' },
  publisher: {
    '@type': 'Organization',
    name: 'Trident Modular',
    url: 'https://tridentmodular.com/',
  },
  mainEntityOfPage: new URL(`/blog/${post.slug}/`, Astro.site).toString(),
}

const meta = seoFor(`/blog/${post.slug}/`, post.title, post.seoDescription || post.excerpt)
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  image={heroImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <article class="bg-white">
    <div class="bg-light border-b border-border py-3">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8 flex items-center gap-2 text-xs text-muted">
        <a href={routes.home} class="hover:text-navy transition-colors">Home</a>
        <span>/</span>
        <a href={routes.blog} class="hover:text-navy transition-colors">Blog</a>
        <span>/</span>
        <span class="text-navy font-medium">{post.title}</span>
      </div>
    </div>

    <header class="max-w-3xl mx-auto px-6 lg:px-8 pt-12 pb-8">
      <p class="text-xs font-semibold font-display uppercase tracking-[0.2em] text-gold mb-3">
        Insights
      </p>
      <h1 class="font-display font-bold text-navy text-3xl lg:text-4xl leading-tight mb-4">
        {post.title}
      </h1>
      <div class="flex items-center gap-3 text-sm text-muted">
        <time datetime={post.date}>{formatted}</time>
        <span>·</span>
        <span>{readMinutes} min read</span>
      </div>
    </header>

    {heroImage && (
      <div class="max-w-4xl mx-auto px-6 lg:px-8 mb-10">
        <img
          src={heroImage}
          alt={post.title}
          class="w-full rounded-2xl"
          loading="eager"
        />
      </div>
    )}

    {/* Body comes straight from WordPress, so it is styled here rather than
        rewritten into components — a like-for-like migration. */}
    <div class="max-w-3xl mx-auto px-6 lg:px-8 pb-16 post-body" set:html={post.html} />

    <div class="border-t border-border bg-light py-14">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8">
        <h2 class="font-display font-bold text-navy text-2xl mb-8">More insights</h2>
        <div class="grid sm:grid-cols-3 gap-6">
          {more.map((p) => (
            <a
              href={`/blog/${p.slug}/`}
              class="group bg-white rounded-2xl overflow-hidden card-shadow card-shadow-hover transition-all duration-300 hover:-translate-y-1"
            >
              {postImage(p.image) && (
                <div class="h-40 overflow-hidden bg-light">
                  <img
                    src={postImage(p.image)}
                    alt={p.title}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  />
                </div>
              )}
              <div class="p-5">
                <h3 class="font-display font-bold text-navy text-sm leading-snug mb-2">{p.title}</h3>
                <p class="text-xs text-muted leading-relaxed line-clamp-3">{p.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  /* WordPress markup arrives unclassed, so style it by element. */
  .post-body {
    color: var(--color-body);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .post-body > * + * {
    margin-top: 1.25rem;
  }
  .post-body h2 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-navy);
    font-size: 1.6rem;
    line-height: 1.3;
    margin-top: 2.5rem;
  }
  .post-body h3 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-navy);
    font-size: 1.25rem;
    margin-top: 2rem;
  }
  .post-body a {
    color: var(--color-navy);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .post-body a:hover {
    color: var(--color-gold);
  }
  .post-body ul,
  .post-body ol {
    padding-left: 1.5rem;
  }
  .post-body ul {
    list-style: disc;
  }
  .post-body ol {
    list-style: decimal;
  }
  .post-body li + li {
    margin-top: 0.5rem;
  }
  .post-body img {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }
  .post-body figure figcaption {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: 0.5rem;
  }
  .post-body blockquote {
    border-left: 3px solid var(--color-gold);
    padding-left: 1.25rem;
    color: var(--color-muted);
    font-style: italic;
  }
  .post-body strong {
    color: var(--color-navy);
    font-weight: 600;
  }
  .post-body table {
    width: 100%;
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
  }
  .post-body td,
  .post-body th {
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
</style>
