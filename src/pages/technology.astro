---
import { seoFor } from '../data/seo'
import BaseLayout from '../layouts/BaseLayout.astro'
import { intro, principles, stages, accreditations } from '../data/technology'
import { factoryPhoto, systemPhoto, thicknesses } from '../data/build-ups'
import BuildUps from '../components/BuildUps'
import { routes } from '../lib/routes'

// Static summary of the build-up data, so the layer system is in the HTML
// without waiting for the interactive selector below it.
const elements = ['External walls', 'Pitched roof', 'Flat roof', 'Floor']
const insulationFor = (mm: number, element: string) => {
  const layers = thicknesses.find((t) => t.mm === mm)?.buildUps.find((b) => b.element === element)?.layers ?? []
  const main = layers.find((l) => l.name === 'Basalt wool insulation')?.spec
  const counter = layers.find((l) => l.name === 'Counter-insulation basalt wool')?.spec
  return main ? (counter ? `${main} + ${counter} counter-insulation` : `${main} wool`) : '—'
}
const frameFor = (mm: number, element: string) =>
  thicknesses.find((t) => t.mm === mm)?.buildUps.find((b) => b.element === element)?.layers.find((l) => l.name === 'Load-bearing frame')?.spec ?? '—'

const meta = seoFor('/technology/', 'Our Technology', 'A closed-panel timber frame system built to ISO 9001:2015, using C24 structural timber and non-combustible basalt wool insulation, with quality control in the factory rather than on site.')
---

<BaseLayout
  title={meta.title}
  description={meta.description}
>
  <div class="bg-white">
    {/* Hero */}
    <section class="bg-navy text-white">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8 py-16 lg:py-24 grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-xs font-semibold font-display uppercase tracking-[0.2em] text-gold mb-4">
            How we build
          </p>
          <h1 class="font-display font-bold text-4xl lg:text-5xl leading-tight mb-5">
            Engineered in the factory, not improvised on site.
          </h1>
          <p class="text-base leading-relaxed" style="color: rgba(255,255,255,0.75)">
            {intro}
          </p>
          <div class="flex flex-col sm:flex-row gap-3 mt-8">
            <a
              href={routes.catalogue}
              class="block text-center bg-gold text-navy font-bold font-display px-8 py-3.5 rounded-xl hover:bg-gold-dark transition-colors text-sm"
            >
              Browse our homes
            </a>
            <a
              href={routes.bopas}
              class="block text-center border border-white/30 text-white font-semibold font-display px-8 py-3.5 rounded-xl hover:bg-white/10 transition-colors text-sm"
            >
              Accreditations
            </a>
          </div>
        </div>
        <figure class="m-0">
          <div class="rounded-2xl overflow-hidden h-72 lg:h-[420px] bg-navy-mid">
            <img
              src={factoryPhoto}
              alt="Trident wall panels being assembled on the factory floor"
              width="1200"
              height="904"
              class="w-full h-full object-cover"
            />
          </div>
          <figcaption class="text-xs mt-3" style="color: rgba(255,255,255,0.55)">
            Wall panels squared and sheathed under cover, before delivery.
          </figcaption>
        </figure>
      </div>
    </section>

    {/* Accreditation strip */}
    <section class="border-b border-border bg-light">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8 py-8 grid grid-cols-2 lg:grid-cols-4 gap-6">
        {accreditations.map((a) => (
          <div>
            <p class="font-display font-bold text-navy text-xl">{a.label}</p>
            <p class="text-xs text-muted mt-1">{a.detail}</p>
          </div>
        ))}
      </div>
    </section>

    {/* The engineering system */}
    <section class="py-20 lg:py-24">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-center mb-14">
          <div>
            <p class="text-xs font-semibold font-display uppercase tracking-[0.2em] text-gold mb-3">
              The system
            </p>
            <h2 class="font-display font-bold text-navy text-3xl lg:text-4xl mb-4">
              One engineering system, not a set of parts
            </h2>
            <p class="text-muted text-base leading-relaxed">
              Every component is designed against the same requirements: energy efficiency, moisture
              resistance and spatial rigidity, held across the whole life of the building.
            </p>
          </div>
          <div class="rounded-2xl overflow-hidden bg-light h-64 lg:h-80">
            <img
              src={systemPhoto}
              alt="Cutaway view of a Trident house showing its structure and layout"
              loading="lazy"
              width="1200"
              height="675"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {principles.map((p) => (
            <div class="bg-white border border-border rounded-2xl p-6 card-shadow">
              <h3 class="font-display font-bold text-navy text-base mb-2">{p.title}</h3>
              <p class="text-sm text-muted leading-relaxed">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Construction build-ups */}
    <section class="bg-light border-t border-border py-20 lg:py-24">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8">
        <div class="max-w-2xl mb-10">
          <p class="text-xs font-semibold font-display uppercase tracking-[0.2em] text-gold mb-3">
            Construction build-ups
          </p>
          <h2 class="font-display font-bold text-navy text-3xl lg:text-4xl mb-4">
            Every layer, specified
          </h2>
          <p class="text-muted text-base leading-relaxed">
            The envelope is built up from the same set of layers whichever model you choose. What
            changes is the depth of the frame and the insulation within it. Select a thickness to
            see the full specification for each element.
          </p>
        </div>

        <BuildUps client:visible />

        <p class="text-xs text-muted mt-8 max-w-2xl leading-relaxed">
          Layers marked optional are specified with you: façade material, roof covering and internal
          finishes are all your choice. Numbers correspond to the diagram beside each list.
        </p>
      </div>
    </section>

    {/* How it is made */}
    <section class="bg-white border-t border-border py-20 lg:py-24">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8">
        <div class="max-w-2xl mb-12">
          <p class="text-xs font-semibold font-display uppercase tracking-[0.2em] text-gold mb-3">
            The process
          </p>
          <h2 class="font-display font-bold text-navy text-3xl lg:text-4xl">
            From production line to prepared foundation
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {stages.map((s) => (
            <div class="bg-white border border-border rounded-2xl p-7 flex gap-5">
              <span class="font-display font-bold text-gold text-2xl shrink-0 leading-none pt-0.5">
                {s.n}
              </span>
              <div>
                <h3 class="font-display font-bold text-navy text-lg mb-2">{s.title}</h3>
                <p class="text-sm text-muted leading-relaxed">{s.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Layer system, static */}
    <section class="bg-light border-t border-border py-20 lg:py-24">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8">
        <div class="max-w-2xl mb-10">
          <p class="text-xs font-semibold font-display uppercase tracking-[0.2em] text-gold mb-3">Offsite construction</p>
          <h2 class="font-display font-bold text-navy text-3xl lg:text-4xl mb-4">Timber frame modular construction UK: the four specifications</h2>
          <p class="text-muted text-base leading-relaxed">
            The same layer set runs through the 100, 150 and 200 mm specifications; the 250 mm option adds a counter-insulated layer across the studs. The table shows frame depth and insulation for each element of the envelope.
          </p>
        </div>
        <div class="overflow-x-auto rounded-2xl border border-border bg-white">
          <table class="w-full text-sm">
            <thead class="bg-navy text-white text-left">
              <tr>
                <th class="px-4 py-3 font-display">Specification</th>
                <th class="px-4 py-3 font-display">Suited to</th>
                {elements.map((e) => <th class="px-4 py-3 font-display whitespace-nowrap">{e}</th>)}
              </tr>
            </thead>
            <tbody>
              {thicknesses.map((t) => (
                <tr class="border-t border-border align-top">
                  <td class="px-4 py-3 font-display font-bold text-navy whitespace-nowrap">{t.mm} mm</td>
                  <td class="px-4 py-3 text-muted min-w-[16rem]">{t.summary}</td>
                  {elements.map((e) => (
                    <td class="px-4 py-3 whitespace-nowrap">
                      <span class="block text-navy font-semibold">{insulationFor(t.mm, e)}</span>
                      <span class="block text-xs text-muted">{frameFor(t.mm, e)} frame</span>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="grid md:grid-cols-3 gap-5 mt-10">
          <div class="bg-white rounded-2xl border border-border p-6">
            <h3 class="font-display font-bold text-navy mb-2">Offsite, then on site</h3>
            <p class="text-sm text-muted leading-relaxed">Posts, beams, floors and panels are made at the production site with insulation, OSB sheathing, membranes and cladding already in place. On site the work is foundation, assembly and finishing.</p>
          </div>
          <div class="bg-white rounded-2xl border border-border p-6">
            <h3 class="font-display font-bold text-navy mb-2">Closed timber frame panels</h3>
            <p class="text-sm text-muted leading-relaxed">Load-bearing C24 softwood at 12–15% moisture content, OSB-3 as the stiffening diaphragm, Juta breather and vapour control membranes either side of the insulation.</p>
          </div>
          <div class="bg-white rounded-2xl border border-border p-6">
            <h3 class="font-display font-bold text-navy mb-2">Quality control in the factory</h3>
            <p class="text-sm text-muted leading-relaxed">Continuous checks at every stage of production and assembly, under ISO 9001:2015, with BOPAS accreditation of the system and a 60-year durability assessment.</p>
          </div>
        </div>
        <p class="text-sm text-muted mt-8">Read the production story on <a href={routes.factoryBuilt} class="text-navy underline underline-offset-2 hover:text-gold">factory-built homes</a>, what to check in any <a href={routes.companies} class="text-navy underline underline-offset-2 hover:text-gold">modular building company</a>, or see how the shell is bought on <a href={routes.kitHomes} class="text-navy underline underline-offset-2 hover:text-gold">kit homes</a>.</p>
      </div>
    </section>

    {/* CTA */}
    <section class="bg-navy text-white py-16 lg:py-20">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8 text-center">
        <h2 class="font-display font-bold text-3xl mb-3">Want to know more about how we build?</h2>
        <p class="text-base mb-8 max-w-xl mx-auto" style="color: rgba(255,255,255,0.7)">
          Tell us about your site and requirements and we will get back to you with our initial
          thoughts.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href={routes.contact}
            class="block text-center bg-gold text-navy font-bold font-display px-8 py-3.5 rounded-xl hover:bg-gold-dark transition-colors text-sm"
          >
            Talk to our team
          </a>
          <a
            href={routes.installation}
            class="block text-center border border-white/30 text-white font-semibold font-display px-8 py-3.5 rounded-xl hover:bg-white/10 transition-colors text-sm"
          >
            Delivery and installation
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
