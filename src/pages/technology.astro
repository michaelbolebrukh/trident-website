---
import BaseLayout from '../layouts/BaseLayout.astro'
import { intro, principles, stages, accreditations } from '../data/technology'
import { media } from '../data/media'
import { routes } from '../lib/routes'
---

<BaseLayout
  title="Our Technology | Trident Modular"
  description="A closed-panel timber frame system built to ISO 9001:2015, using C24 structural timber and non-combustible basalt wool insulation, with quality control in the factory rather than on site."
>
  <div class="bg-white">
    {/* Hero */}
    <section class="bg-navy text-white">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8 py-16 lg:py-24 grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-xs font-semibold font-display uppercase tracking-[0.2em] text-gold mb-4">
            How we build
          </p>
          <h1 class="font-display font-bold text-4xl lg:text-5xl leading-tight mb-5">
            Engineered in the factory, not improvised on site.
          </h1>
          <p class="text-base leading-relaxed" style="color: rgba(255,255,255,0.75)">
            {intro}
          </p>
          <div class="flex flex-col sm:flex-row gap-3 mt-8">
            <a
              href={routes.catalogue}
              class="block text-center bg-gold text-navy font-bold font-display px-8 py-3.5 rounded-xl hover:bg-gold-dark transition-colors text-sm"
            >
              Browse our homes
            </a>
            <a
              href={routes.bopas}
              class="block text-center border border-white/30 text-white font-semibold font-display px-8 py-3.5 rounded-xl hover:bg-white/10 transition-colors text-sm"
            >
              Accreditations
            </a>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden h-72 lg:h-[420px] bg-navy-mid">
          <img
            src={media.chaletExterior}
            alt="A Trident timber-frame building"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </section>

    {/* Accreditation strip */}
    <section class="border-b border-border bg-light">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8 py-8 grid grid-cols-2 lg:grid-cols-4 gap-6">
        {accreditations.map((a) => (
          <div>
            <p class="font-display font-bold text-navy text-xl">{a.label}</p>
            <p class="text-xs text-muted mt-1">{a.detail}</p>
          </div>
        ))}
      </div>
    </section>

    {/* The engineering system */}
    <section class="py-20 lg:py-24">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8">
        <div class="max-w-2xl mb-12">
          <p class="text-xs font-semibold font-display uppercase tracking-[0.2em] text-gold mb-3">
            The system
          </p>
          <h2 class="font-display font-bold text-navy text-3xl lg:text-4xl mb-4">
            One engineering system, not a set of parts
          </h2>
          <p class="text-muted text-base leading-relaxed">
            Every component is designed against the same requirements: energy efficiency, moisture
            resistance and spatial rigidity, held across the whole life of the building.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {principles.map((p) => (
            <div class="bg-white border border-border rounded-2xl p-6 card-shadow">
              <h3 class="font-display font-bold text-navy text-base mb-2">{p.title}</h3>
              <p class="text-sm text-muted leading-relaxed">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* How it is made */}
    <section class="bg-light border-t border-border py-20 lg:py-24">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8">
        <div class="max-w-2xl mb-12">
          <p class="text-xs font-semibold font-display uppercase tracking-[0.2em] text-gold mb-3">
            The process
          </p>
          <h2 class="font-display font-bold text-navy text-3xl lg:text-4xl">
            From production line to prepared foundation
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {stages.map((s) => (
            <div class="bg-white border border-border rounded-2xl p-7 flex gap-5">
              <span class="font-display font-bold text-gold text-2xl shrink-0 leading-none pt-0.5">
                {s.n}
              </span>
              <div>
                <h3 class="font-display font-bold text-navy text-lg mb-2">{s.title}</h3>
                <p class="text-sm text-muted leading-relaxed">{s.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* CTA */}
    <section class="bg-navy text-white py-16 lg:py-20">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8 text-center">
        <h2 class="font-display font-bold text-3xl mb-3">Want to know more about how we build?</h2>
        <p class="text-base mb-8 max-w-xl mx-auto" style="color: rgba(255,255,255,0.7)">
          Tell us about your site and requirements and we will get back to you with our initial
          thoughts.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href={routes.contact}
            class="block text-center bg-gold text-navy font-bold font-display px-8 py-3.5 rounded-xl hover:bg-gold-dark transition-colors text-sm"
          >
            Talk to our team
          </a>
          <a
            href={routes.installation}
            class="block text-center border border-white/30 text-white font-semibold font-display px-8 py-3.5 rounded-xl hover:bg-white/10 transition-colors text-sm"
          >
            Delivery and installation
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
