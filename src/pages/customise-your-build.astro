---
import { seoFor } from '../data/seo'
import BaseLayout from '../layouts/BaseLayout.astro'
import BespokePage from '../components/BespokePage'

const meta = seoFor('/customise-your-build/', 'Bespoke & Commercial Buildings', 'Bespoke modular design for homes, workspaces and commercial buildings. Tell us the site and the brief and our team will develop a tailored solution.')
---

<BaseLayout
  title={meta.title}
  description={meta.description}
>
  <BespokePage />
</BaseLayout>
