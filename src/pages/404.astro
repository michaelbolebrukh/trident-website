---
import BaseLayout from '../layouts/BaseLayout.astro'
import { routes } from '../lib/routes'
---

<BaseLayout
  title="Page not found | Trident Modular"
  description="The page you were looking for could not be found."
  noindex={true}
>
  <div class="min-h-[60vh] flex items-center justify-center bg-white px-6 py-20">
    <div class="text-center max-w-lg">
      <p class="text-xs font-semibold font-display uppercase tracking-[0.2em] text-gold mb-3">Error 404</p>
      <h1 class="font-display font-bold text-navy text-4xl lg:text-5xl mb-4">We can't find that page.</h1>
      <p class="text-muted text-base mb-8">
        It may have moved, or the link may be out of date. You can browse our homes
        or get in touch and we'll point you in the right direction.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={routes.catalogue}
          class="bg-gold text-navy font-bold font-display px-8 py-3.5 rounded-xl hover:bg-gold-dark transition-colors text-sm"
        >
          Browse our homes
        </a>
        <a
          href={routes.contact}
          class="border border-border text-navy font-semibold font-display px-8 py-3.5 rounded-xl hover:bg-light transition-colors text-sm"
        >
          Contact us
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
