---
import { seoFor } from '../data/seo'
import BaseLayout from '../layouts/BaseLayout.astro'
import InstallationPage from '../components/InstallationPage'
import TurnkeySection from '../components/TurnkeySection.astro'

const meta = seoFor('/installation/', 'Delivery & Installation', 'How a Trident build reaches your site — groundworks, delivery logistics, craning and assembly, through to base, shell or fully finished turnkey handover.')
---

<BaseLayout
  title={meta.title}
  description={meta.description}
>
  <InstallationPage client:afterpaint />
  <TurnkeySection />
</BaseLayout>
