---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import CategoryPage from '../../components/CategoryPage'
import { allHomes, PRIMARY_CATEGORIES } from '../../data/homes'
import { categoryTerms } from '../../data/categories'
import { categorySeo } from '../../data/seo'
import { categoryCrumbs } from '../../lib/breadcrumbs'
import { breadcrumbSchema } from '../../lib/schema'
import CategorySections from '../../components/CategorySections.astro'

/**
 * Category pages keep the URL the old site used, /houses-type/<slug>/, so the
 * ranking they already hold carries over without a redirect.
 */

export function getStaticPaths() {
  return Object.entries(categoryTerms)
    .map(([slug, term]) => ({
      slug,
      term,
      homes: allHomes.filter((h) => h.categories.includes(term.name)),
    }))
    // A term with nothing in it would be a thin page and a dead end.
    .filter(({ homes }) => homes.length > 0)
    .map(({ slug, term, homes }) => ({
      params: { category: slug },
      props: { slug, term, homes },
    }))
}

const { slug, term, homes } = Astro.props
const isPrimary = PRIMARY_CATEGORIES.includes(term.name as (typeof PRIMARY_CATEGORIES)[number])

const meta = categorySeo(slug, term, homes)
const crumbs = categoryCrumbs(term.name)
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  schema={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs crumbs={crumbs} />
  <CategoryPage
    name={term.name}
    blurb={term.blurb}
    homes={homes}
    isPrimary={isPrimary}
    client:afterpaint
  />
  <CategorySections slug={slug} />
</BaseLayout>
