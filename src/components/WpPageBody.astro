---
/**
 * Shell for pages carried over from WordPress.
 *
 * The body arrives as sanitised semantic HTML (see scripts/import-pages.mjs),
 * so it is styled here by element rather than by class, the same way blog
 * posts are.
 */
interface Props {
  eyebrow: string
  title: string
  intro?: string
  html: string
}

const { eyebrow, title, intro, html } = Astro.props
---

<div class="bg-white">
  <div class="bg-light border-b border-border py-12">
    <div class="max-w-[1280px] mx-auto px-6 lg:px-8">
      <p class="text-xs font-semibold font-display uppercase tracking-[0.2em] text-gold mb-3">
        {eyebrow}
      </p>
      <h1 class="font-display font-bold text-navy text-4xl lg:text-5xl">{title}</h1>
      {intro && <p class="text-muted text-base mt-4 max-w-2xl leading-relaxed">{intro}</p>}
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-6 lg:px-8 py-14 wp-body" set:html={html} />
</div>

<style is:global>
  .wp-body {
    color: var(--color-body);
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .wp-body > * + * {
    margin-top: 1.15rem;
  }
  .wp-body h2,
  .wp-body h3 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.3;
    margin-top: 2.5rem;
  }
  .wp-body h2 {
    font-size: 1.6rem;
  }
  .wp-body h3 {
    font-size: 1.25rem;
  }
  .wp-body a {
    color: var(--color-navy);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .wp-body a:hover {
    color: var(--color-gold);
  }
  .wp-body ul {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .wp-body ol {
    list-style: decimal;
    padding-left: 1.5rem;
  }
  .wp-body li + li {
    margin-top: 0.4rem;
  }
  .wp-body img {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }
  .wp-body strong {
    color: var(--color-navy);
    font-weight: 600;
  }
</style>
