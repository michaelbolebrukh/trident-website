---
/**
 * The long-form sections under a category's model cards: intro, choosing
 * guide, FAQ and links to the price guide and kit homes. Only categories
 * with an entry in category-content.ts render these.
 */
import { categoryContent } from '../data/category-content'
import FaqBlock from './FaqBlock.astro'
import { routes, productPath } from '../lib/routes'
import { floorAreaText } from '../lib/area'
import { pricingFor, formatPrice } from '../lib/price-options'
import { specFor } from '../data/catalogue-specs'
import type { Home } from '../data/homes'

interface Props {
  slug: string
  /** The category's models, for the comparison table. */
  homes?: Home[]
}
const { slug, homes = [] } = Astro.props
const content = categoryContent[slug]

// The models side by side, from the same data the model pages use.
const rows = [...homes]
  .sort((a, b) => a.price - b.price)
  .map((h) => {
    const pricing = pricingFor(h.slug)
    const shell = pricing && !pricing.onRequest ? pricing.options[0].price : null
    const spec = specFor(h.slug)
    return {
      name: h.name,
      href: productPath(h.slug),
      area: floorAreaText(h),
      bedrooms: spec?.bedrooms ?? h.bedrooms,
      bathrooms: spec?.bathrooms ?? h.bathrooms,
      floors: h.floors,
      from: shell === null ? 'On request' : `from ${formatPrice(shell)}`,
    }
  })
---

{content && (
  <div class="bg-white">
    <section class="border-t border-border py-14">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8">
        <h2 class="font-display font-bold text-navy text-2xl mb-4">{content.introTitle}</h2>
        <div class="max-w-3xl space-y-4">
          {content.intro.map((p) => <p class="text-body leading-relaxed">{p}</p>)}
        </div>
      </div>
    </section>

    {rows.length > 0 && (
      <section class="border-t border-border py-14">
        <div class="max-w-[1280px] mx-auto px-6 lg:px-8">
          <h2 class="font-display font-bold text-navy text-2xl mb-2">Compare the models</h2>
          <p class="text-sm text-muted mb-6 max-w-2xl">Floor areas, room counts and storeys from the catalogue; the from-price is the Shell delivered option, excluding VAT.</p>
          <div class="overflow-x-auto rounded-2xl border border-border">
            <table class="w-full text-sm">
              <caption class="sr-only">Models in this category compared by area, bedrooms, bathrooms, storeys and from-price</caption>
              <thead>
                <tr class="bg-navy text-white text-left">
                  <th scope="col" class="px-4 py-3 font-display font-semibold">Model</th>
                  <th scope="col" class="px-4 py-3 font-display font-semibold">Floor area</th>
                  <th scope="col" class="px-4 py-3 font-display font-semibold">Bedrooms</th>
                  <th scope="col" class="px-4 py-3 font-display font-semibold">Bathrooms</th>
                  <th scope="col" class="px-4 py-3 font-display font-semibold">Storeys</th>
                  <th scope="col" class="px-4 py-3 font-display font-semibold whitespace-nowrap">Shell delivered</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr class="border-t border-border">
                    <th scope="row" class="px-4 py-3 text-left font-display font-semibold text-navy"><a href={r.href} class="hover:text-gold">{r.name}</a></th>
                    <td class="px-4 py-3 text-muted whitespace-nowrap">{r.area}</td>
                    <td class="px-4 py-3 text-muted">{r.bedrooms || '—'}</td>
                    <td class="px-4 py-3 text-muted">{r.bathrooms || '—'}</td>
                    <td class="px-4 py-3 text-muted">{r.floors}</td>
                    <td class="px-4 py-3 text-navy font-semibold whitespace-nowrap">{r.from}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )}

    <section class="border-t border-border bg-light py-14">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-8">
        <h2 class="font-display font-bold text-navy text-2xl mb-8">{content.choosingTitle}</h2>
        <div class="grid md:grid-cols-2 gap-5">
          {content.choosing.map((c) => (
            <div class="bg-white rounded-2xl border border-border p-6">
              <h3 class="font-display font-bold text-navy mb-2">{c.title}</h3>
              <p class="text-sm text-muted leading-relaxed">{c.body}</p>
            </div>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={routes.prices} class="text-sm font-semibold font-display text-navy underline underline-offset-2 hover:text-gold">Full price guide for every model →</a>
          <a href={routes.kitHomes} class="text-sm font-semibold font-display text-navy underline underline-offset-2 hover:text-gold">Buy as a kit: the Shell delivered option →</a>
          <a href={routes.forSale} class="text-sm font-semibold font-display text-navy underline underline-offset-2 hover:text-gold">Modular homes for sale: how buying works →</a>
        </div>
      </div>
    </section>

    <FaqBlock title={content.faqTitle} questions={content.faq} />
  </div>
)}
