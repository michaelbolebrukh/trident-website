---
/**
 * Visible breadcrumb trail. Static markup, no JavaScript. The same items feed
 * the BreadcrumbList schema on the page, see src/lib/schema.ts.
 */
import type { Crumb } from '../lib/breadcrumbs'

interface Props {
  crumbs: Crumb[]
  /** Set when the trail sits on a light band already, e.g. a category header. */
  flush?: boolean
}

const { crumbs, flush = false } = Astro.props
const last = crumbs.length - 1
---

<nav
  aria-label="Breadcrumb"
  class:list={['text-xs text-muted', flush ? 'mb-4' : 'bg-light border-b border-border py-3']}
>
  <ol class:list={['flex flex-wrap items-center gap-x-2 gap-y-1', !flush && 'max-w-[1280px] mx-auto px-6 lg:px-8']}>
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-2 min-w-0">
        {i < last ? (
          <a href={c.href} class="hover:text-navy transition-colors">{c.name}</a>
        ) : (
          <span class="text-navy font-medium truncate" aria-current="page">{c.name}</span>
        )}
        {i < last && <span aria-hidden="true">›</span>}
      </li>
    ))}
  </ol>
</nav>
